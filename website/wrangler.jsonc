{
  "name": "translation-foundation",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first so every response gets the security headers.
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // CSP violation reports are capped at 10 a minute per connection.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  // REPO: the shared GitHub repository the films and subtitle files are read from (raw files, cached for a minute).
  // RAW_BASE (optional): read the files from somewhere else, for example a local copy while developing.
  "vars": {
    "REPO": "NikaSigua/translation-foundation",
    "BRANCH": "main"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "translation.foundation.ge", "custom_domain": true }
  ]
}
